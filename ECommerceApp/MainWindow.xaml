<Window x:Class="ECommerceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ECommerceApp"
        mc:Ignorable="d"
        Title="E-Commerce" Height="360" Width="340" WindowStartupLocation="CenterScreen"
        Background="Transparent"  AllowsTransparency="True" WindowStyle="None">

    <Grid>
        <!-- Main Content -->
        <Border CornerRadius="12" Padding="20" Background="#1E1E1E" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <!-- Custom Close Button -->
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0"
        HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="Button_Click">
                    <TextBlock Text="✖" FontSize="16" Foreground="Gray"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="Opacity" Value="0.7"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <TextBlock Text="✖" FontSize="16" Foreground="Gray"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                    To="White" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                    To="Gray" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>


                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,40,10,10">
                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameBox" Height="35" FontSize="14" Padding="5" BorderThickness="1" 
                             BorderBrush="#555" Background="#2E2E2E" Foreground="White"/>

                    <!-- Spacer -->
                    <TextBlock Height="10"/>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="35" FontSize="14" Padding="5" BorderThickness="1" 
                                 BorderBrush="#555" Background="#2E2E2E" Foreground="White"/>

                    <!-- Spacer -->
                    <TextBlock Height="20"/>

                    <!-- Buttons -->
                    <Button x:Name="LoginBtn" Content="Login" Height="40" Background="#4CAF50" Foreground="White"
                            FontSize="14" BorderThickness="0" Padding="5" HorizontalAlignment="Stretch"
                            Cursor="Hand" Click="LoginBtn_Click"/>

                    <Button x:Name="RegisterBtn" Content="Register" Height="40" Background="#2196F3" Foreground="White"
                            FontSize="14" BorderThickness="0" Padding="5" HorizontalAlignment="Stretch" 
                            Margin="0 10 0 0" Cursor="Hand" Click="RegisterBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
