<Window x:Class="ECommerceApp.ProductAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Product" Height="422" Width="397" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Grid>

        <!-- Form Container -->
        <Border CornerRadius="12" Padding="20" Background="#1E1E1E"
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,40,10,10">
                <!-- Product Name Label and TextBox -->
                <TextBlock Text="Product Name" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="ProductNameBox" Height="30" FontSize="14" Padding="5" BorderThickness="1" 
                         BorderBrush="#555" Background="#2E2E2E" Foreground="White"/>

                <!-- Spacer -->
                <TextBlock Height="10"/>

                <!-- Price Label and TextBox -->
                <TextBlock Text="Price" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="PriceBox" Height="30" FontSize="14" Padding="5" BorderThickness="1" 
                         BorderBrush="#555" Background="#2E2E2E" Foreground="White"/>

                <!-- Spacer -->
                <TextBlock Height="10"/>

                <!-- Quantity Label and TextBox -->
                <TextBlock Text="Quantity" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="QuantityBox" Height="30" FontSize="14" Padding="5" BorderThickness="1" 
                         BorderBrush="#555" Background="#2E2E2E" Foreground="White"/>

                <!-- Spacer -->
                <TextBlock Height="20"/>

                <!-- Save Button -->
                <Button Content="Save" Height="40" Background="#4CAF50" Foreground="White" FontSize="14"
                        BorderThickness="0" Padding="5" HorizontalAlignment="Stretch" Cursor="Hand" 
                        Click="Button_Click"/>
                <Button Content="Close" Height="40" Width="290" Margin="0 10 0 0" Background="#F44336" Foreground="White" FontSize="14"
        BorderThickness="0" Padding="5" HorizontalAlignment="Center" Cursor="Hand"
        Click="CloseButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
